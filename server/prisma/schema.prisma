// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  offers    Offer[]
  tokens    Token[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id         String    @id @default(cuid())
  title      String?
  type       TypeOffer
  company    String
  url        String
  applyDate  DateTime
  location   String?
  expiryDate DateTime?
  status     Status    @default(PENDING)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])
  userId     String

  @@index([applyDate]) // Index sur applyDate pour des recherches rapides
  @@index([company]) // Index sur company pour des recherches rapides
}

model Token {
  id        String   @id @default(cuid())
  token     String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum TypeOffer {
  SPONTANEOUS
  BYOFFER
}

enum Status {
  PENDING
  INTERVIEW
  REJECTED
  ACCEPTED
}
